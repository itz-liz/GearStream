  "item": [
    {
      "name": "Empresas",
      "item": [
        {
          "name": "Crear empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Empresa Postman\",\n  \"direccion\": \"Av. Pruebas 123\",\n  \"correo\": \"empresa.postman@example.com\",\n  \"telefono\": \"555-0101\",\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/empresas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea la empresa (201)', () => pm.response.to.have.status(201));",
                  "const empresa = pm.response.json();",
                  "pm.expect(empresa._id).to.be.a('string');",
                  "pm.collectionVariables.set('empresaId', empresa._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar empresas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/empresas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista empresas (200)', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar empresa creada",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/empresas/{{empresaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta empresa (200)', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('empresaId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar empresa",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Empresa Postman Actualizada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/empresas/{{empresaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza empresa (200)', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().nombre).to.eql('Empresa Postman Actualizada');"
                ]
              }
            }
          ]
        }
      ]
    },
